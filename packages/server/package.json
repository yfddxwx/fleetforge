{
  "name": "@fleetforge/server",
  "version": "0.1.0",
  "description": "Fastify API + WebSocket gateway for the fleet.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "@fleetforge/drivers": "workspace:*",
    "@fleetforge/orchestrator": "workspace:*",
    "@fleetforge/schema": "workspace:*",
    "@fleetforge/store": "workspace:*",
    "@fleetforge/usage": "workspace:*",
    "@fleetforge/worktree": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@fleetforge/sim-agent": "workspace:*",
    "vitest": "^3.0.5",
    "@types/ws": "^8.5.13",
    "ws": "^8.18.0"
  }
}
