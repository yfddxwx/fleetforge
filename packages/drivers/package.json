{
  "name": "@fleetforge/drivers",
  "version": "0.1.0",
  "description": "AgentDriver unified interface + built-in drivers (claude-code, codex, zcode, generic-shell, sim).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fleetforge/schema": "workspace:*",
    "@fleetforge/cli": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.5",
    "@fleetforge/sim-agent": "workspace:*"
  }
}
