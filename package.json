{
  "name": "fleetforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent fleet command deck: orchestrate coding-agent CLIs (Claude Code, Codex, ZCode...) into an isolated, parallel workforce with git worktrees.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "eslint .",
    "coverage:core": "pnpm --filter @fleetforge/schema --filter @fleetforge/worktree --filter @fleetforge/orchestrator run test:coverage",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "clean": "pnpm -r run clean && node -e \"fs.rmSync('node_modules',{recursive:true,force:true})\"",
    "fleet": "node packages/cli/dist/main.js"
  },
  "dependencies": {
    "@fleetforge/cli": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  }
}
